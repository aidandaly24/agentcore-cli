// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`scaffolds valid YAML with inactive examples and a resolvable prompt 1`] = `
"# Harness configuration: https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness.html
# Commented settings are examples, not defaults.

name: assistant

# Supported providers: bedrock, open_ai, gemini, lite_llm.
# Omitted tuning settings are left to the service and provider unless explicitly set by this file.
# https://docs.aws.amazon.com/bedrock-agentcore-control/latest/APIReference/API_HarnessModelConfiguration.html
model:
  provider: bedrock
  modelId: global.anthropic.claude-sonnet-4-6
  # temperature: 0.2
  # topP: 0.9
  # maxTokens: 4096
  # apiFormat: converse_stream
  # apiKeyArn: YOUR_API_KEY_PROVIDER_ARN

# Edit system-prompt.md next to this file, or set inline instructions below to override it.
# systemPrompt: |
#   You are a helpful assistant.
#   Ask for clarification when a request is ambiguous.

# Managed memory is created for this harness.
# Remove this block or set mode to disabled to turn memory off.
# For existing memory, set mode to existing and add arn or name (for a memory in this project).
# https://docs.aws.amazon.com/bedrock-agentcore-control/latest/APIReference/API_HarnessMemoryConfiguration.html
memory:
  mode: managed
  # strategies: [SEMANTIC, SUMMARIZATION, USER_PREFERENCE, EPISODIC]
  # eventExpiryDuration: 30 # Days.

# Add tools alongside the harness's built-in shell and file operations.
# Choose a unique name for each entry. The harness uses this name for the tool.
# For Remote MCP, Gateway, Browser, Code Interpreter, and other tool configurations, see:
# https://docs.aws.amazon.com/bedrock-agentcore-control/latest/APIReference/API_HarnessTool.html
# tools:
#   - name: research
#     type: remote_mcp
#     config:
#       remoteMcp:
#         url: https://mcp.example.com/mcp

# Limit which available tools the agent can use. "*" allows all available tools.
# Restrict with patterns such as "@builtin" or "@research/search".
# AWS permissions must still be configured separately.
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-tools.html
allowedTools: ["*"]

# Load skills from S3 (s3Uri), Git (gitUrl), container files (path), or bundled AWS skills (awsSkills).
# With gitUrl, path is a folder in that repository. A standalone path is inside the harness container.
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-skills.html
skills: []

# Limits for one invocation, across all model calls.
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-operations.html#harness-limits
# maxIterations: 15
# maxTokens: 20000
# timeoutSeconds: 300

# Controls how conversation history is kept within the model's context window.
# https://docs.aws.amazon.com/bedrock-agentcore-control/latest/APIReference/API_HarnessTruncationConfiguration.html
truncation:
  strategy: sliding_window
  # config:
  #   slidingWindow:
  #     messagesCount: 40

# Values must be strings. Put quotes around numbers and booleans.
# Environment values are stored in plaintext.
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-environment.html
environmentVariables: {}

# Use a local Dockerfile OR an ECR image. Omit both to use the service-provided environment.
# Dockerfile paths are relative to this file's directory.
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-environment.html#harness-custom-container
# dockerfile: Dockerfile
# containerUri: 123456789012.dkr.ecr.us-west-2.amazonaws.com/my-harness:latest

# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-security.html#harness-network-config
# To use the VPC example below, change networkMode to VPC and replace the resource IDs.
# vpcId is required for Dockerfile builds in VPC mode.
networkMode: PUBLIC
# networkConfig:
#   vpcId: vpc-0123456789abcdef0
#   subnets: [subnet-0123456789abcdef0]
#   securityGroups: [sg-0123456789abcdef0]

# Caller authentication, separate from the credentials used to call models or tools.
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-security.html
# To use JWT, change authorizerType to CUSTOM_JWT and configure your identity provider below.
authorizerType: AWS_IAM
# authorizerConfiguration:
#   customJwtAuthorizer:
#     discoveryUrl: https://id.example.com/.well-known/openid-configuration
#     allowedAudience: [my-harness-app]

# Deployment will create an execution role when omitted. Manage permissions yourself for a supplied role.
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-security.html#harness-execution-role-policy
# executionRoleArn: arn:aws:iam::123456789012:role/MyHarnessRole

# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-operations.html#harness-limits
# lifecycleConfig:
#   idleRuntimeSessionTimeout: 900
#   maxLifetime: 28800

# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-environment.html
# sessionStoragePath: /mnt/session

# EFS and S3 Files mounts require VPC mode. Each entry contains an accessPointArn and mountPath.
# Mount paths must be under /mnt and must be unique across all filesystem types.
efsAccessPoints: []
s3AccessPoints: []

# Grant access to existing resources and expose their connection details as environment variables.
# This does not add agent tools; declare those under tools.
connections: []

# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-operations.html
tags: {}
"
`;
